# Dapatkan API key percuma di https://pixabay.com/api/docs/
PIXABAY_API_KEY=masukkan_api_key_pixabay_anda_di_sini
# Dapatkan API key di https://zernio.com
ZERNIO_API_KEY=masukkan_api_key_zernio_anda_di_sini

# Meta Graph API (Facebook Page + Instagram Business)
META_ACCESS_TOKEN=masukkan_system_user_token_meta_di_sini
META_PAGE_ID=pilihan_jika_ada_lebih_dari_satu_page

# Cloudinary (untuk public HTTPS URL poster Instagram)
CLOUDINARY_CLOUD_NAME=masukkan_cloud_name
CLOUDINARY_API_KEY=masukkan_api_key
CLOUDINARY_API_SECRET=masukkan_api_secret
